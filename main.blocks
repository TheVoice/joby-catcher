# How many seconds to rotate 360 degrees</comment><value name="VALUE"><shadow type="math_number" id="?#q6ZnVL=w1J-C#3ZjK{"><field name="NUM">5</field></shadow></value><next><block type="typescript_statement" id="j_{ZSX`cjCxgG]G:@mwa"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="class Box {" line1="    id: number" line2="    x: number" line3="    y: number" line4="    w: number" line5="    h: number" line6="    constructor(id: number, x: number, y: number, w: number, h: number) {" line7="        this.id = id" line8="        this.x = x" line9="        this.y = y" line10="        this.w = w" line11="        this.h = h" line12="    }" line13="    " line14="    public size() {" line15="        return this.w * this.w + this.h * this.h" line16="    }" line17="    " line18="    public time_to_reach_box(): number {" line19="        return (FRAME_H - this.y) / TIME_TO_CROSS_100_CM_IN_SEC" line20="    }" line21="    " line22="    public mark() {" line23="        huskylens.writeOSD(&quot;X&quot;, this.x, this.y)" line24="    }" line25="    " line26="    public to_text(): string {" line27="        return &quot;[&quot; + this.id + &quot;,&quot; + this.x + &quot;,&quot; + this.y + &quot;,&quot; + this.w + &quot;,&quot; + this.h + &quot;]&quot;" line28="    }" line29="    " line30="}" numlines="31"></mutation><next><block type="variables_set" id="+|HUjy}t_lSriW,h_Eq3"><field name="VAR" id=";lJ2+@cF{v!qOpP+qZIp">angle_start</field><value name="VALUE"><shadow type="math_number" id="n,cZtME5KbfC0W/v}+KE"><field name="NUM">-1</field></shadow></value><next><block type="typescript_statement" id="//7dY9[#zD]IJU!k0hx$"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="function get_closest_box(red_id: number = 1): Box {" line1="    let x: number;" line2="    let y: number;" line3="    let w: number;" line4="    let h: number;" line5="    let box: Box;" line6="    huskylens.clearOSD()" line7="    display_state()" line8="    huskylens.request()" line9="    //  Refresh data" line10="    let total = huskylens.getBox(HUSKYLENSResultType_t.HUSKYLENSResultBlock)" line11="    huskylens.writeOSD(&quot;Count: &quot; + total, 10, 20)" line12="    let result = null" line13="    for (let i = 1; i &lt; total + 1; i++) {" line14="        //  Lire l'ID du bloc i" line15="        // id_i = huskylens.reade_box(i, Content1.ID)" line16="        // if id_i == red_id:" line17="        huskylens.request()" line18="        //  Refresh data" line19="        x = huskylens.readeBox_index(1, i, Content1.xCenter)" line20="        y = huskylens.readeBox_index(1, i, Content1.yCenter)" line21="        w = huskylens.readeBox_index(1, i, Content1.width)" line22="        h = huskylens.readeBox_index(1, i, Content1.height)" line23="        box = new Box(i, x, y, w, h)" line24="        huskylens.writeOSD(box.to_text(), 10, 20 + 20 * i)" line25="        if (i === 1) {" line26="            result = box" line27="        } else if (result.y &lt; box.y) {" line28="            result = box" line29="        }" line30="        " line31="    }" line32="    if (result) {" line33="        result.mark()" line34="    }" line35="    " line36="    return result" line37="}" numlines="38"></mutation><next><block type="device_print_message" id="uxko]BQ):X_K=ygC^qn("><value name="text"><shadow type="text" id="k3DUA{]!Aqp*iTg#z8hp"><field name="TEXT">ON3-2</field></shadow></value><next><block type="device_show_leds" id="A|2DMfPHXnCqcO=2itRg"><field name="LEDS">`
